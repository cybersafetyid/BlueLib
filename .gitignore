# Gradle files
.gradle/
build/
.kotlin/

# Local Gradle distribution used to bootstrap the wrapper
.gradle-dist/

# Agent skills installed locally with "npx add-skill" (see docs/contributing.md; the installed set is
# recorded in skills-lock.json so a fresh clone can reproduce it)
.agents/skills/

# Local configuration file (sdk path, etc)
local.properties

# Log/OS Files
*.log

# Android Studio generated files and folders
captures/
.externalNativeBuild/
.cxx/
*.aab
*.apk
output-metadata.json

# IntelliJ
*.iml
.idea/
misc.xml
deploymentTargetDropDown.xml
render.experimental.xml

# Keystore files
*.jks
*.keystore

# Google Services (e.g. APIs or Firebase)
google-services.json

# Android Profiling
*.hprof

# MkDocs output
/site/

# Exported signing keys must never be committed; see docs/releasing.md
*.asc

# Local release signing key material (private key, passphrase, revocation cert)
/.release-key/
