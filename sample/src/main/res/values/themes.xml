<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.BlueLibSample" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/blue_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/blue_100</item>
        <item name="colorOnPrimaryContainer">@color/blue_900</item>
        <item name="colorSecondary">@color/blue_500</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/blue_100</item>
        <item name="colorOnSecondaryContainer">@color/blue_900</item>
        <item name="colorTertiary">@color/blue_900</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorSurfaceVariant">@color/blue_50</item>
        <item name="colorOnSurfaceVariant">@color/ink_muted</item>
        <item name="colorSurfaceContainer">@color/white</item>
        <item name="colorSurfaceContainerLow">@color/white</item>
        <item name="colorSurfaceContainerHigh">@color/blue_50</item>
        <!-- Unchecked switch thumbs and text field borders use colorOutline: keep it legible. -->
        <item name="colorOutline">@color/outline_strong</item>
        <item name="colorSurfaceContainerHighest">@color/blue_100</item>
        <item name="colorOutlineVariant">@color/outline</item>
        <item name="colorError">@color/danger</item>
        <item name="android:colorBackground">@color/blue_50</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">true</item>
        <item name="materialCardViewStyle">@style/Widget.Sample.Card</item>
        <item name="textInputStyle">@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense</item>
        <item name="shapeAppearanceCornerMedium">@style/ShapeAppearance.Sample.Medium</item>
    </style>

    <style name="ShapeAppearance.Sample.Medium" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">14dp</item>
    </style>

    <style name="Widget.Sample.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">20dp</item>
        <item name="strokeColor">@color/outline</item>
        <item name="cardBackgroundColor">@color/white</item>
        <item name="contentPadding">18dp</item>
        <item name="android:layout_marginBottom">16dp</item>
    </style>

    <style name="TextAppearance.Sample.CardTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Sample.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/ink_muted</item>
    </style>

    <style name="TextAppearance.Sample.Section" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textColor">@color/blue_700</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="TextAppearance.Sample.Mono" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">monospace</item>
        <item name="fontFamily">monospace</item>
        <item name="android:typeface">monospace</item>
        <item name="android:textColor">@color/console_text</item>
    </style>

    <!-- Root of the Sample.* layout styles below (dotted names inherit from it). -->
    <style name="Sample" />

    <!-- Card title row: icon + bold title -->
    <style name="Sample.CardTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:drawablePadding">10dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="drawableTint">@color/blue_700</item>
        <item name="android:textAppearance">@style/TextAppearance.Sample.CardTitle</item>
    </style>

    <style name="Sample.Caption">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:textAppearance">@style/TextAppearance.Sample.Caption</item>
    </style>

    <style name="Sample.Button" parent="Widget.Material3.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
    </style>

    <style name="Sample.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
    </style>

    <style name="Sample.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="strokeColor">@color/blue_200</item>
    </style>

    <style name="Sample.Row">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="Sample.Input">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">10dp</item>
    </style>
</resources>
